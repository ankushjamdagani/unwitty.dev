    "@turbo/gen": "^2.5.6",
    "prettier": "^3.6.2",
    "turbo": "^2.9.9"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/lodash": "^4.17.20",
    "lodash": "^4.17.21",
    "typescript": "^5.9.2"
  }
}

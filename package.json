{
  "name": "unwitty-dev",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "bootstrap-all": "(sh apps/web/bootstrap.sh); (sh projects/gameboy-shell/bootstrap.sh); (sh projects/cosmic-velocity/bootstrap.sh)",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@common/eslint-config": "workspace:*",

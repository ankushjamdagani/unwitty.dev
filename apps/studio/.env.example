# Fine-grained GitHub token, Contents: read-only on product repos.
# Optional for public repos (lower rate limit without it).
GITHUB_TOKEN=

# Base URL of each product deployment, keyed by slug (upper-cased, dashes → underscores).
# Requests to unwitty.dev/<slug>/* are proxied here.
PRODUCT_URL_CANVAS_ONE=https://canvas-one.vercel.app
